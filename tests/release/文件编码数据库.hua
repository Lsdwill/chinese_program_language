导入 标准.文件 为 文件
导入 标准.编码 为 编码
导入 标准.数据库 为 数据库

文件.写入字节("二进制.dat", 编码.UTF8编码("华言 Linux"))
让 原文 = 文件.读取字节("二进制.dat")
打印(编码.UTF8解码(原文))
打印(编码.十六进制编码(原文))

让 库 = 数据库.打开(":memory:")
数据库.建表(库, "测试表", 记录 {编号: "文字", 名称: "文字", 数值: "整数"})
数据库.插入(库, "测试表", 记录 {编号: "二", 名称: "乙", 数值: 2})
数据库.插入(库, "测试表", 记录 {编号: "一", 名称: "甲", 数值: 1})
让 结果 = 选择 测试表 从 库
    排序 编号 升序
    限制 1
结束
打印(结果[0].编号)

让 事务 = 数据库.开始事务(库)
数据库.插入(事务, "测试表", 记录 {编号: "三", 名称: "丙", 数值: 3})
数据库.回滚(事务)
让 不存在 = 数据库.选择一行(库, "测试表", 记录 {编号: "三"})
打印(不存在)
数据库.关闭(库)
