模块 图书馆.主

导入 标准.数据库 为 数据库
导入 标准.文件 为 文件
导入 标准.时间 为 时间

函数 输入文字(提示)
    打印(提示)
    返回 输入()
结束

函数 初始化数据库(库)
    数据库.建表(库, "图书", 记录 {
        编号: "文字",
        书名: "文字",
        作者: "文字",
        年份: "整数",
        状态: "文字"
    })
    数据库.建表(库, "读者", 记录 {
        编号: "文字",
        姓名: "文字",
        联系方式: "文字"
    })
    数据库.建表(库, "借阅", 记录 {
        编号: "文字",
        图书编号: "文字",
        读者编号: "文字",
        借出时间: "文字",
        归还时间: "文字",
        状态: "文字"
    })
结束

函数 添加图书(库)
    让 编号 = 输入文字("图书编号：")
    让 已有 = 数据库.选择一行(库, "图书", 记录 {编号: 编号})
    如果 已有 != 空
        抛出 错误("图书编号已经存在")
    结束
    让 书名 = 输入文字("书名：")
    让 作者 = 输入文字("作者：")
    让 年份 = 转整数(输入文字("出版年份："))
    数据库.插入(库, "图书", 记录 {编号: 编号, 书名: 书名, 作者: 作者, 年份: 年份, 状态: "可借"})
    打印("添加图书成功")
结束

函数 查询图书(库)
    让 关键词 = 输入文字("图书编号（直接回车查看全部）：")
    让 图书列表 = 空
    如果 关键词 == ""
        图书列表 = 选择 图书 从 库
            排序 编号 升序
            限制 100
        结束
    否则
        图书列表 = 选择 图书 从 库
            其中 编号 等于 关键词
            限制 1
        结束
    结束
    如果 图书列表.长度() == 0
        打印("没有找到图书")
    否则
        遍历 图书 于 图书列表
            打印(图书.编号 + "：" + 图书.书名 + "，作者：" + 图书.作者 + "，状态：" + 图书.状态)
        结束
    结束
结束

函数 登记读者(库)
    让 编号 = 输入文字("读者编号：")
    让 已有 = 数据库.选择一行(库, "读者", 记录 {编号: 编号})
    如果 已有 != 空
        抛出 错误("读者编号已经存在")
    结束
    让 姓名 = 输入文字("姓名：")
    让 联系方式 = 输入文字("联系方式：")
    数据库.插入(库, "读者", 记录 {编号: 编号, 姓名: 姓名, 联系方式: 联系方式})
    打印("登记读者成功")
结束

函数 查询读者(库)
    让 读者列表 = 选择 读者 从 库
        排序 编号 升序
        限制 100
    结束
    遍历 读者 于 读者列表
        打印(读者.编号 + "：" + 读者.姓名 + "，联系方式：" + 读者.联系方式)
    结束
结束

函数 借阅图书(库)
    让 图书编号 = 输入文字("图书编号：")
    让 读者编号 = 输入文字("读者编号：")
    让 图书 = 数据库.选择一行(库, "图书", 记录 {编号: 图书编号})
    如果 图书 == 空
        抛出 错误("图书不存在")
    结束
    如果 图书.状态 != "可借"
        抛出 错误("图书当前不可借")
    结束
    让 读者 = 数据库.选择一行(库, "读者", 记录 {编号: 读者编号})
    如果 读者 == 空
        抛出 错误("读者不存在")
    结束
    让 借阅编号 = 图书编号 + "-" + 读者编号
    数据库.插入(库, "借阅", 记录 {编号: 借阅编号, 图书编号: 图书编号, 读者编号: 读者编号, 借出时间: 时间.现在(), 归还时间: "", 状态: "借出"})
    数据库.更新(库, "图书", 记录 {状态: "借出"}, 记录 {编号: 图书编号})
    打印("借阅成功：" + 借阅编号)
结束

函数 归还图书(库)
    让 图书编号 = 输入文字("图书编号：")
    让 读者编号 = 输入文字("读者编号：")
    让 借阅编号 = 图书编号 + "-" + 读者编号
    让 借阅 = 数据库.选择一行(库, "借阅", 记录 {编号: 借阅编号})
    如果 借阅 == 空
        抛出 错误("借阅记录不存在")
    结束
    如果 借阅.状态 != "借出"
        抛出 错误("这条借阅记录已经归还")
    结束
    数据库.更新(库, "借阅", 记录 {归还时间: 时间.现在(), 状态: "已归还"}, 记录 {编号: 借阅编号})
    数据库.更新(库, "图书", 记录 {状态: "可借"}, 记录 {编号: 图书编号})
    打印("归还成功：" + 借阅编号)
结束

函数 查询借阅(库)
    让 借阅列表 = 选择 借阅 从 库
        排序 编号 升序
        限制 100
    结束
    如果 借阅列表.长度() == 0
        打印("没有借阅记录")
    否则
        遍历 借阅 于 借阅列表
            打印(借阅.编号 + "：" + 借阅.状态 + "，借出时间：" + 借阅.借出时间)
        结束
    结束
结束

函数 删除图书(库)
    让 编号 = 输入文字("要删除的图书编号：")
    让 图书 = 数据库.选择一行(库, "图书", 记录 {编号: 编号})
    如果 图书 == 空
        抛出 错误("图书不存在")
    结束
    如果 图书.状态 != "可借"
        抛出 错误("借出中的图书不能删除")
    结束
    数据库.删除(库, "图书", 记录 {编号: 编号})
    打印("删除图书成功")
结束

函数 显示菜单()
    打印("")
    打印("====== 华言图书管理系统 ======")
    打印("1. 添加图书")
    打印("2. 查询图书")
    打印("3. 登记读者")
    打印("4. 查询读者")
    打印("5. 借阅图书")
    打印("6. 归还图书")
    打印("7. 查询借阅")
    打印("8. 删除图书")
    打印("0. 退出系统")
结束

函数 主()
    文件.创建目录("数据")
    让 库 = 数据库.打开("数据/图书馆.db")
    尝试
        初始化数据库(库)
        让 运行中 = 真
        当 运行中
            显示菜单()
            让 选择 = 输入文字("请选择：")
            尝试
                如果 选择 == "1"
                    添加图书(库)
                否则如果 选择 == "2"
                    查询图书(库)
                否则如果 选择 == "3"
                    登记读者(库)
                否则如果 选择 == "4"
                    查询读者(库)
                否则如果 选择 == "5"
                    借阅图书(库)
                否则如果 选择 == "6"
                    归还图书(库)
                否则如果 选择 == "7"
                    查询借阅(库)
                否则如果 选择 == "8"
                    删除图书(库)
                否则如果 选择 == "0"
                    运行中 = 假
                否则
                    打印("无效选择")
                结束
            捕获 原因
                打印("操作失败：" + 原因.消息)
            结束
        结束
    最后
        数据库.关闭(库)
    结束
结束

主()
