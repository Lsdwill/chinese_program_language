导入 标准.文件 为 文件
导入 标准.数据库 为 数据库

文件.创建目录("数据")
让 库 = 数据库.打开("数据/图书馆.db")

尝试
    数据库.建表(库, "图书", 记录 {
        编号: "文字",
        书名: "文字",
        作者: "文字",
        年份: "整数"
    })

    数据库.删除(库, "图书")
    让 事务 = 数据库.开始事务(库)
    数据库.插入(事务, "图书", 记录 {编号: "B001", 书名: "活着", 作者: "余华", 年份: 1993})
    数据库.插入(事务, "图书", 记录 {编号: "B002", 书名: "围城", 作者: "钱钟书", 年份: 1947})
    数据库.提交(事务)

    打印("全部图书：")
    让 图书列表 = 选择 图书 从 库
        排序 编号 升序
        限制 20
    结束
    遍历 图书 于 图书列表
        打印(图书.编号 + "：" + 图书.书名 + "，作者：" + 图书.作者)
    结束

    让 目标 = 选择 图书 从 库
        其中 编号 等于 "B001"
        限制 1
    结束
    如果 目标.长度() > 0
        打印("找到：" + 目标[0].书名)
    结束

    数据库.更新(库, "图书", 记录 {年份: 2024}, 记录 {编号: "B002"})
    让 更新后 = 数据库.选择一行(库, "图书", 记录 {编号: "B002"})
    打印("更新年份：" + 转文字(更新后.年份))
最后
    数据库.关闭(库)
结束
